# CSM admin password for Edit/Save (+ metrics refresh)
CSM_ADMIN_PASSWORD=klaviyo-csm

# Required for one-click Refresh metrics on the page (Secret on Vercel).
# Create a read-only private API key in Klaviyo → Settings → API keys.
# KLAVIYO_PRIVATE_API_KEY=

# Optional dedicated token for agent metrics ingest
# METRICS_INGEST_TOKEN=

# Durable plan Save on Vercel (Project → Storage → Create Blob Store).
# BLOB_READ_WRITE_TOKEN=

# Optional: Placed Order metric id (auto-detected if omitted)
# KLAVIYO_CONVERSION_METRIC_ID=
